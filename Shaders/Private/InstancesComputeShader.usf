#include "/Engine/Public/Platform.ush"

RWStructuredBuffer<float4> SpawnPositions;
Texture2D<float> SceneDepthTexture;
SamplerState SceneDepthSampler;

float3 CameraPosition;
float3 CameraForward;
float3 CameraRight;
float3 CameraUp;
float OrthoWidth;
float OrthoHeight;
uint NumInstances;
float GridCellSize;
float SpawnDensity;
float VerticalOffset;

float Hash2D(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

[numthreads(10, 100, 1)]
void MainCS(uint3 ThreadId : SV_DispatchThreadID)
{
    uint Width = 10;
    uint X = ThreadId.x;
    uint Y = ThreadId.y;
    uint Index = Y * Width + X;

    if (Index >= NumInstances)
        return;

    uint GridWidth  = (uint)sqrt((float)NumInstances);
    uint GridHeight = GridWidth;

    uint GridX = Index % GridWidth;
    uint GridY = Index / GridWidth;

    float camRadius = length(CameraPosition);

    // cellRad converts GridCellSize (metres) to radians.
    // MUST be constant every frame — if we derive it from camRadius, any
    // altitude change shifts all floor() snap boundaries and the grid shuffles.
    // Hardcode the planet surface radius here instead.
    static const float PlanetRadius = 16000000.0f; // <-- set to your planet radius in UE units
    float cellRad = GridCellSize / PlanetRadius;

    // -------------------------------------------------------------------------
    // STEP 1: Snap in lon/lat — the only coordinate system that is truly
    // discrete and world-fixed on a sphere. These are pure functions of the
    // camera footprint direction, containing zero altitude or orientation info.
    // -------------------------------------------------------------------------
    float3 footDir = normalize(CameraPosition);
    float camLon = atan2(footDir.y, footDir.x);
    float camLat = asin(clamp(footDir.z, -1.0, 1.0));

    // Snap to cell boundaries.
    float snappedLon = floor(camLon / cellRad) * cellRad;
    float snappedLat = floor(camLat / cellRad) * cellRad;

    // Integer cell index for this thread, centred on camera.
    int cellX = (int)GridX - (int)(GridWidth  / 2);
    int cellY = (int)GridY - (int)(GridHeight / 2);

    // Lon/lat of this cell — world-fixed, integer steps from snapped origin.
    float cellLon = snappedLon + (float)cellX * cellRad;
    float cellLat = snappedLat + (float)cellY * cellRad;

    // -------------------------------------------------------------------------
    // STEP 2: Stable integer seed from cell lon/lat indices.
    // round() gives the same integers for the same cell regardless of anything.
    // -------------------------------------------------------------------------
    float2 gridSeed = float2(
        round(cellLon / cellRad),
        round(cellLat / cellRad)
    );

    // -------------------------------------------------------------------------
    // STEP 3: Per-cell jitter in angular space — world-fixed, seed-only.
    // -------------------------------------------------------------------------
    float jitterLon = (Hash2D(gridSeed)                      - 0.5) * cellRad * 0.9;
    float jitterLat = (Hash2D(gridSeed + float2(42.0, 13.0)) - 0.5) * cellRad * 0.9;

    float sampleLon = cellLon + jitterLon;
    float sampleLat = cellLat + jitterLat;

    // -------------------------------------------------------------------------
    // STEP 4: Convert lon/lat to 3D world position at camera radius.
    // This point is world-fixed and stable.
    // -------------------------------------------------------------------------
    float cosLat     = cos(sampleLat);
    float3 sampleDir = float3(cosLat * cos(sampleLon),
                              cosLat * sin(sampleLon),
                              sin(sampleLat));

    float3 sampleWorld = sampleDir * PlanetRadius;

    // -------------------------------------------------------------------------
    // STEP 5: UV — project 3D offset onto camera Right/Up.
    // -------------------------------------------------------------------------
    float3 worldOffset = sampleWorld - CameraPosition;
    float offsetRight  = dot(worldOffset, CameraRight);
    float offsetUp     = dot(worldOffset, CameraUp);

    float2 uv;
    uv.x =  offsetRight / OrthoWidth  + 0.5;
    uv.y = -offsetUp    / OrthoHeight + 0.5;
    uv = saturate(uv);

    float depth = SceneDepthTexture.SampleLevel(SceneDepthSampler, uv, 0);

    bool didHit = depth > 0.0;

    float4 result;

    if (!didHit)
    {
        result = float4(0, 0, 0, 0);
    }
    else
    {
        float spawnRandom = Hash2D(gridSeed + float2(100.0, 200.0));
        bool shouldSpawn  = spawnRandom < SpawnDensity;

        if (shouldSpawn)
        {
            // Surface point: travel from sampleWorld toward sphere centre by depth.
            // sampleDir is stable (world-fixed), depth gives terrain radius.
            // Equivalent of flat shader's CameraPosition.z - depth.
            float3 surfacePoint  = sampleDir * (camRadius - depth);
            float3 worldPosition = surfacePoint + sampleDir * VerticalOffset;

            float scaleVariation = 0.7 + Hash2D(gridSeed + float2(7.0, 8.0)) * 0.6;
            int meshesCount = 5;
            int   meshIndex      = (int)(Hash2D(gridSeed + float2(53.0, 31.0)) * meshesCount);
            // Pack: integer part = meshIndex, fractional part = scaleVariation (0.7-1.3)
            // Since scaleVariation < 2.0, meshIndex*10 + scaleVariation is unambiguous
            result = float4(worldPosition, (float)meshIndex * 10.0 + scaleVariation);
        }
        else
        {
            result = float4(0, 0, 0, 0);
        }
    }

    SpawnPositions[Index] = result;
}
